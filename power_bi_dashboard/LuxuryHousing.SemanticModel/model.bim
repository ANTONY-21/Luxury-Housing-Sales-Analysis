        ],
        "partitions": [
          {
            "name": "luxury_housing",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(CleanedDataPath), [Delimiter=\",\", Columns=36, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Promoted, {{\"Property_ID\", type text}, {\"Project_Name\", type text}, {\"Developer_Name\", type text}, {\"Micro_Market\", type text}, {\"Latitude\", type number}, {\"Longitude\", type number}, {\"Map_Location\", type text}, {\"Configuration\", type text}, {\"Unit_Size_Sqft\", type number}, {\"Size_Category\", type text}, {\"Ticket_Price_Cr\", type number}, {\"Price_per_Sqft\", type number}, {\"Price_Segment\", type text}, {\"Is_Price_Outlier\", Int64.Type}, {\"Transaction_Type\", type text}, {\"Booking_Flag\", Int64.Type}, {\"Booking_Status\", type text}, {\"Possession_Status\", type text}, {\"Sales_Channel\", type text}, {\"Buyer_Type\", type text}, {\"NRI_Buyer\", type text}, {\"Buyer_Comments\", type text}, {\"Comment_Sentiment\", type text}, {\"Amenity_Score\", type number}, {\"Amenity_Band\", type text}, {\"Connectivity_Score\", type number}, {\"Locality_Infra_Score\", type number}, {\"Avg_Traffic_Time_Min\", Int64.Type}, {\"Purchase_Date\", type date}, {\"Purchase_Year\", Int64.Type}, {\"Quarter_Number\", Int64.Type}, {\"Quarter_Label\", type text}, {\"Fiscal_Year\", type text}, {\"Price_Imputed\", Int64.Type}, {\"Size_Imputed\", Int64.Type}, {\"Amenity_Imputed\", Int64.Type}})",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
      {
