                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "formatString": "Short Date",
            "isKey": true
          },
          {
            "type": "calculatedTableColumn",
            "name": "Year",
            "dataType": "int64",
            "sourceColumn": "[Year]",
            "summarizeBy": "none",
            "annotations": [
