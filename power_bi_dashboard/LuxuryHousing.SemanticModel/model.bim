        ],
        "partitions": [
          {
            "name": "DimDate",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": "VAR MinDate = MIN ( luxury_housing[Purchase_Date] ) VAR MaxDate = MAX ( luxury_housing[Purchase_Date] ) RETURN ADDCOLUMNS ( CALENDAR ( MinDate, MaxDate ), \"Year\", YEAR ( [Date] ), \"Quarter Number\", QUARTER ( [Date] ), \"Quarter Label\", FORMAT ( [Date], \"YYYY\" ) & \"-Q\" & QUARTER ( [Date] ), \"Quarter Sort\", YEAR ( [Date] ) * 10 + QUARTER ( [Date] ), \"Fiscal Year\", \"FY\" & YEAR ( EDATE ( [Date], -3 ) ) & \"-\" & RIGHT ( YEAR ( EDATE ( [Date], -3 ) ) + 1, 2 ), \"Month Name\", FORMAT ( [Date], \"MMM YYYY\" ), \"Month Number\", MONTH ( [Date] ) )"
            }
          }
        ]
      },
      {
        "name": "Measures",
        "columns": [
          {
            "type": "calculatedTableColumn",
            "name": "Placeholder",
            "dataType": "int64",
            "isHidden": true,
            "sourceColumn": "[Placeholder]",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          }
        ],
        "measures": [
          {
            "name": "Total Properties",
            "expression": "COUNTROWS ( luxury_housing )",
            "description": "Row count of the fact table under the current filter context.",
            "formatString": "#,0"
          },
          {
            "name": "Total Bookings",
            "expression": "SUM ( luxury_housing[Booking_Flag] )",
            "description": "Count of Primary transactions, treated as bookings.",
            "formatString": "#,0"
          },
          {
            "name": "Drop Offs",
            "expression": "[Total Properties] - [Total Bookings]",
            "description": "Transactions that did not convert to a booking.",
            "formatString": "#,0"
          },
          {
            "name": "Booking Conversion %",
            "expression": "DIVIDE ( [Total Bookings], [Total Properties], 0 )",
            "description": "Share of transactions that are bookings.",
            "formatString": "0.00%"
          },
          {
            "name": "Drop Off Rate %",
            "expression": "1 - [Booking Conversion %]",
            "description": "Complement of booking conversion.",
            "formatString": "0.00%"
          },
          {
            "name": "Avg Ticket Price Cr",
            "expression": "AVERAGE ( luxury_housing[Ticket_Price_Cr] )",
            "description": "Mean ticket price in crore rupees.",
            "formatString": "#,0.00 \"Cr\""
          },
          {
            "name": "Median Ticket Price Cr",
            "expression": "MEDIAN ( luxury_housing[Ticket_Price_Cr] )",
            "description": "Median ticket price in crore rupees.",
            "formatString": "#,0.00 \"Cr\""
          },
          {
            "name": "Avg Price per Sqft",
            "expression": "AVERAGE ( luxury_housing[Price_per_Sqft] )",
            "description": "Mean price per square foot in rupees.",
            "formatString": "#,0"
          },
          {
            "name": "Total Pipeline Value Cr",
            "expression": "SUM ( luxury_housing[Ticket_Price_Cr] )",
            "description": "Sum of ticket prices in crore rupees.",
            "formatString": "#,0 \"Cr\""
          },
          {
            "name": "Avg Unit Size Sqft",
            "expression": "AVERAGE ( luxury_housing[Unit_Size_Sqft] )",
            "description": "Mean unit size in square feet.",
            "formatString": "#,0"
          },
          {
            "name": "Avg Amenity Score",
            "expression": "AVERAGE ( luxury_housing[Amenity_Score] )",
            "description": "Mean amenity score out of 10.",
            "formatString": "#,0.00"
          },
          {
            "name": "Positive Sentiment %",
            "expression": "DIVIDE ( CALCULATE ( [Total Properties], luxury_housing[Comment_Sentiment] = \"Positive\" ), CALCULATE ( [Total Properties], luxury_housing[Comment_Sentiment] <> \"No Comment\" ), 0 )",
            "description": "Positive share of buyers who left a comment.",
            "formatString": "0.00%"
          },
          {
            "name": "Negative Sentiment %",
            "expression": "DIVIDE ( CALCULATE ( [Total Properties], luxury_housing[Comment_Sentiment] = \"Negative\" ), CALCULATE ( [Total Properties], luxury_housing[Comment_Sentiment] <> \"No Comment\" ), 0 )",
            "description": "Negative share of buyers who left a comment.",
            "formatString": "0.00%"
          },
          {
            "name": "Market Avg Price per Sqft",
            "expression": "CALCULATE ( AVERAGE ( luxury_housing[Price_per_Sqft] ), ALLEXCEPT ( luxury_housing, luxury_housing[Micro_Market] ) )",
            "description": "Price per sqft for the whole micro-market, ignoring builder filters.",
            "formatString": "#,0"
          },
          {
            "name": "Price Premium vs Market %",
            "expression": "DIVIDE ( [Avg Price per Sqft] - [Market Avg Price per Sqft], [Market Avg Price per Sqft], 0 )",
            "description": "How far above or below the local market a builder prices.",
            "formatString": "+0.00%;-0.00%;0.00%"
          },
          {
            "name": "Builder Rank by Price",
            "expression": "RANKX ( ALLSELECTED ( luxury_housing[Developer_Name] ), [Avg Ticket Price Cr],, DESC )",
            "description": "Rank of the builder by average ticket price.",
            "formatString": "0"
          },
          {
            "name": "Booking Status Share %",
            "expression": "DIVIDE ( [Total Properties], CALCULATE ( [Total Properties], ALL ( luxury_housing[Booking_Status] ) ) )",
            "description": "Share of a segment's rows in each booking status. Drives the 100% stacked columns for questions 4 and 6.",
            "formatString": "0.00%"
          },
          {
            "name": "Builder Revenue Rank",
            "expression": "RANKX ( ALLSELECTED ( luxury_housing[Developer_Name] ), [Total Pipeline Value Cr],, DESC )",
            "description": "Rank of the builder by total revenue. Question 10.",
            "formatString": "0"
          },
          {
            "name": "Is Top 5 Builder",
            "expression": "IF ( [Builder Revenue Rank] <= 5, 1, 0 )",
            "description": "Flag for the top five builders by revenue. Use as a visual filter.",
            "formatString": "0"
          },
          {
            "name": "Top 5 Builders Revenue Cr",
            "expression": "SUMX ( TOPN ( 5, ALLSELECTED ( luxury_housing[Developer_Name] ), [Total Pipeline Value Cr], DESC ), [Total Pipeline Value Cr] )",
            "description": "Combined revenue of the top five builders. Question 10 KPI card.",
            "formatString": "#,0 \"Cr\""
          },
          {
            "name": "Top 5 Builders Bookings",
            "expression": "SUMX ( TOPN ( 5, ALLSELECTED ( luxury_housing[Developer_Name] ), [Total Pipeline Value Cr], DESC ), [Total Bookings] )",
            "description": "Combined bookings of the top five builders by revenue. Question 10 KPI card.",
            "formatString": "#,0"
          },
          {
            "name": "Previous Quarter Bookings",
            "expression": "CALCULATE ( [Total Bookings], PREVIOUSQUARTER ( DimDate[Date] ) )",
            "description": "Bookings in the preceding quarter.",
            "formatString": "#,0"
          },
          {
            "name": "QoQ Booking Growth %",
            "expression": "VAR Previous = [Previous Quarter Bookings] RETURN DIVIDE ( [Total Bookings] - Previous, Previous )",
            "description": "Quarter-over-quarter change in bookings.",
            "formatString": "+0.00%;-0.00%;0.00%"
          },
          {
            "name": "Previous Quarter Avg Price",
            "expression": "CALCULATE ( [Avg Ticket Price Cr], PREVIOUSQUARTER ( DimDate[Date] ) )",
            "description": "Average ticket price in the preceding quarter.",
            "formatString": "#,0.00 \"Cr\""
          },
          {
            "name": "QoQ Price Change %",
            "expression": "VAR Previous = [Previous Quarter Avg Price] RETURN DIVIDE ( [Avg Ticket Price Cr] - Previous, Previous )",
            "description": "Quarter-over-quarter change in average price.",
            "formatString": "+0.00%;-0.00%;0.00%"
          },
          {
            "name": "Rolling 4Q Avg Price",
            "expression": "AVERAGEX ( DATESINPERIOD ( DimDate[Date], MAX ( DimDate[Date] ), -12, MONTH ), [Avg Ticket Price Cr] )",
            "description": "Trailing four-quarter average ticket price.",
            "formatString": "#,0.00 \"Cr\""
          },
          {
            "name": "Conversion CI Half Width",
            "expression": "VAR N = [Total Properties] VAR P = [Booking Conversion %] RETURN IF ( N > 0, 1.96 * SQRT ( DIVIDE ( P * ( 1 - P ), N ) ) )",
            "description": "Half width of the 95% confidence interval on conversion.",
            "formatString": "0.00%"
          },
          {
            "name": "Conversion Lower Bound",
            "expression": "[Booking Conversion %] - [Conversion CI Half Width]",
            "description": "Lower bound of the 95% confidence interval on conversion.",
            "formatString": "0.00%"
          },
          {
            "name": "Conversion Upper Bound",
            "expression": "[Booking Conversion %] + [Conversion CI Half Width]",
            "description": "Upper bound of the 95% confidence interval on conversion.",
            "formatString": "0.00%"
          },
          {
            "name": "Conversion Signal",
            "expression": "IF ( [Conversion Lower Bound] > 0.5 || [Conversion Upper Bound] < 0.5, \"Distinguishable from baseline\", \"Within noise\" )",
            "description": "Whether conversion differs measurably from the 50% baseline. Reads 'Within noise' everywhere on this dataset - that is the finding."
          }
        ],
        "partitions": [
          {
            "name": "Measures",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": "ROW(\"Placeholder\", 1)"
            }
          }
        ]
      }
